---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

// Datos de los servicios con sus respectivos horarios y descripciones
const servicios = [
  {
    titulo: "Fisioterapia",
    dias: "Lunes a Viernes",
    horario: "09:30 - 14:30 y 16:30 - 21:00",
    descripcion: "Enfoque clínico avanzado para la recuperación de lesiones musculares, tendinosas y articulares. Trabajamos tanto la fase aguda como la readaptación funcional completa para asegurar un retorno seguro a tu actividad física habitual.",
    foto: "/images/flowers_entrance.jpg", // Puedes cambiarla o dejarla lista
  },
  {
    titulo: "Fisioterapia de Suelo Pélvico",
    dias: "Martes y Jueves",
    horario: "09:00 - 14:00",
    descripcion: "Valoración y tratamiento integral de las disfunciones del suelo pélvico femenino y masculino (incontinencias, dolores pélvicos, preparación al parto y recuperación posparto) con tecnología y técnicas especializadas.",
    foto: "/images/flowers_entrance.jpg",
  },
  {
    titulo: "Entrenamiento personal",
    dias: "Lunes, Miércoles y Viernes",
    horario: "15:00 - 20:30",
    descripcion: "Abordaje global del cuerpo que busca restaurar el equilibrio biomecánico mediante técnicas manuales suaves y precisas, aliviando dolores tensionales crónicos, cervicalgias y cefaleas.",
    foto: "/images/flowers_entrance.jpg",
  },
  {
    titulo: "Pilates",
    dias: "Lunes a Viernes",
    horario: "10:00-14:00 y 17:00 - 21:00",
    descripcion: "Abordaje global del cuerpo que busca restaurar el equilibrio biomecánico mediante técnicas manuales suaves y precisas, aliviando dolores tensionales crónicos, cervicalgias y cefaleas.",
    foto: "/images/flowers_entrance.jpg",
  },
  {
    titulo: "Consulta nutricionista",
    dias: "Lunes, Miércoles y Viernes",
    horario: "10:00 - 12:00 y 17:00 - 19:00",
    descripcion: "Clases orientadas a la mejora de la postura, la flexibilidad y la fuerza central del cuerpo. Grupos reducidos y adaptados bajo supervisión directa de fisioterapeutas colegiados.",
    foto: "/images/flowers_entrance.jpg",
  }
];
---

<Layout 
  title="Servicios y Horarios | MERAKI Fisioterapia y Movimiento" 
  description="Conoce nuestros servicios de fisioterapia deportiva, suelo pélvico, osteopatía y pilates terapéutico. Consulta horarios y disponibilidad."
>
  <Navbar />

  <main class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mx-auto text-center space-y-4 mb-20">
        <span class="inline-block bg-orange-100/80 text-amber-800 text-xs font-semibold px-3.5 py-1.5 rounded-full uppercase tracking-wider">
          Nuestros Tratamientos
        </span>
        <h1 class="text-4xl sm:text-5xl font-bold text-stone-900 tracking-tight">
          Especialidades pensadas para <span class="text-amber-600">tu recuperación</span>
        </h1>
        <p class="text-lg text-stone-600">
          Combinamos la evidencia científica con un trato humano y cercano para ofrecerte soluciones adaptadas a cada etapa de tu salud.
        </p>
      </div>

      <div class="space-y-20 lg:space-y-28">
        {servicios.map((servicio, index) => (
          <div class={`grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center ${index % 2 === 1 ? 'lg:grid-flow-dense' : ''}`}>
            
            <!-- Image -->
            <div class={`relative flex justify-center ${index % 2 === 1 ? 'lg:col-start-2' : ''}`}>
              <div class="w-full max-w-md sm:max-w-none h-80 sm:h-96 rounded-3xl overflow-hidden shadow-xl border border-amber-200/60 bg-amber-50">
                <img 
                  src={servicio.foto} 
                  alt={servicio.titulo} 
                  class="w-full h-full object-cover"
                />
              </div>
            </div>

            <!-- Info column -->
            <div class={`space-y-6 ${index % 2 === 1 ? 'lg:col-start-1' : ''}`}>
              
              <div class="space-y-2">
                <span class="text-amber-600 font-semibold text-sm uppercase tracking-wider">
                  Área Clínica
                </span>
                <h2 class="text-3xl font-bold text-stone-900 tracking-tight">
                  {servicio.titulo}
                </h2>
              </div>

              <!-- Schedule block -->
              <div class="bg-amber-50/80 border border-amber-200/60 rounded-2xl p-4 sm:p-5 space-y-2">
                <div class="flex items-center gap-2 text-stone-800 font-semibold text-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span>Días: <span class="font-normal text-stone-700">{servicio.dias}</span></span>
                </div>
                <div class="flex items-center gap-2 text-stone-800 font-semibold text-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>Horario: <span class="font-normal text-stone-700">{servicio.horario}</span></span>
                </div>
              </div>

              <p class="text-stone-600 text-base leading-relaxed">
                {servicio.descripcion}
              </p>

              <div class="pt-2">
                <a 
                  href="/contacto" 
                  class="inline-block bg-amber-600 hover:bg-amber-700 text-white font-semibold px-6 py-3 rounded-xl shadow-md transition-all text-sm"
                >
                  Consultar disponibilidad
                </a>
              </div>

            </div>

          </div>
        ))}
      </div>

    </div>
  </main>
</Layout>